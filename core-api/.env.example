# --- API inti (entrypoint aktif: app.main:app) ---
APP_ENV=development
DATABASE_PATH=data/rangkul.sqlite3
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Token admin individual. WAJIB diganti dengan token acak >= 32 karakter di staging/produksi.
ADMIN_CREDENTIALS=[{"token":"dev-system-admin-token","name":"Admin Pengembangan","role":"system_admin"},{"token":"dev-content-reviewer-token","name":"Reviewer Konten","role":"content_reviewer"},{"token":"dev-hospital-admin-token","name":"Admin RS Demo","role":"hospital_admin","hospital_id":"rs-pilot-demo"}]

# --- Fase 2: chat, RAG, dan provider LLM ---
# Gunakan fake untuk pengembangan tanpa panggilan jaringan. Isi GROQ_API_KEY
# lalu ubah LLM_PROVIDER=groq untuk mencoba provider sebenarnya.
LLM_PROVIDER=fake
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=600
CHAT_ENABLED=true
CHAT_MAX_MESSAGE_CHARS=2000
CHAT_HISTORY_TURNS=6
CHAT_TOP_K=4
CHAT_SIMILARITY_THRESHOLD=0.2
CHAT_MAX_CONTEXT_CHARS=6000
AI_CONSENT_VERSION=privacy-notice-v1
CRISIS_CONTACT=
RATE_LIMIT_PUBLIC_PER_MINUTE=120
RATE_LIMIT_ADMIN_PER_MINUTE=60
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- Legacy: main.py yang diparkir. Dipakai kembali saat fasenya tiba. ---
COMMUNITY_DB_PATH=data/community_guides.sqlite3
FACILITY_DOCS_DIR=data/facility-documents
FACILITY_ADMIN_TOKEN=ganti-dengan-token-acak-yang-panjang
