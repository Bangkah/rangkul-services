{
  "info": {
    "name": "API Inti RANGKUL",
    "description": "Kontrak API staging untuk frontend RANGKUL. Isi {{baseUrl}} setelah deployment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "{{STAGING_URL}}"},
    {"key": "facilityAdminToken", "value": "{{FACILITY_ADMIN_TOKEN}}"},
    {"key": "facilityDocumentId", "value": "{{FACILITY_DOCUMENT_ID}}"}
  ],
  "item": [
    {
      "name": "Chat (streaming NDJSON)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"messages\": [{\"role\": \"user\", \"content\": \"Bagaimana mencari fasilitas kesehatan?\"}]\n}", "options": {"raw": {"language": "json"}}},
        "url": {"raw": "{{baseUrl}}/api/chat", "host": ["{{baseUrl}}"], "path": ["api", "chat"]}
      }
    },
    {
      "name": "Daftar fasilitas demo",
      "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/facilities", "host": ["{{baseUrl}}"], "path": ["api", "facilities"]}}
    },
    {
      "name": "Daftar dokumen fasilitas mitra (admin)",
      "request": {"method": "GET", "header": [{"key": "X-Facility-Admin-Token", "value": "{{facilityAdminToken}}"}], "url": {"raw": "{{baseUrl}}/api/facility-documents", "host": ["{{baseUrl}}"], "path": ["api", "facility-documents"]}}
    },
    {
      "name": "Unggah dokumen fasilitas mitra (admin)",
      "request": {"method": "POST", "header": [{"key": "X-Facility-Admin-Token", "value": "{{facilityAdminToken}}"}], "body": {"mode": "formdata", "formdata": [{"key": "file", "type": "file", "src": ""}]}, "url": {"raw": "{{baseUrl}}/api/facility-documents", "host": ["{{baseUrl}}"], "path": ["api", "facility-documents"]}}
    },
    {
      "name": "Hapus dokumen fasilitas mitra (admin)",
      "request": {"method": "DELETE", "header": [{"key": "X-Facility-Admin-Token", "value": "{{facilityAdminToken}}"}], "url": {"raw": "{{baseUrl}}/api/facility-documents/{{facilityDocumentId}}", "host": ["{{baseUrl}}"], "path": ["api", "facility-documents", "{{facilityDocumentId}}"]}}
    },
    {
      "name": "Simulasi pendaftaran",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"text\": \"Simulasi pendaftaran untuk demo UI\"\n}", "options": {"raw": {"language": "json"}}},
        "url": {"raw": "{{baseUrl}}/api/register-dummy", "host": ["{{baseUrl}}"], "path": ["api", "register-dummy"]}
      }
    },
    {
      "name": "Kirim panduan komunitas (pending)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"text\": \"Dari halte, jalan ke arah gerbang utama.\"\n}", "options": {"raw": {"language": "json"}}},
        "url": {"raw": "{{baseUrl}}/api/community-guide", "host": ["{{baseUrl}}"], "path": ["api", "community-guide"]}
      }
    }
  ]
}
